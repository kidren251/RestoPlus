# Active l'authentification obligatoire des routes métier.
REQUIRE_AUTH=true

# Projet Supabase de l'univers restaurant déployé.
SUPABASE_URL=https://example.supabase.co

# Clé utilisée par le backend pour ses propres requêtes (ex: lookup de membership).
# À utiliser en priorité : contourne intentionnellement la RLS, l'autorisation étant
# déjà vérifiée côté code (auth.ts). Ne jamais exposer côté mobile/client.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Repli si la clé service_role n'est pas encore configurée (dev uniquement) : une fois
# la RLS activée (migration 0006), les requêtes internes du backend échoueront avec
# cette clé, puisque auth.uid() est nul côté serveur.
SUPABASE_ANON_KEY=replace-me